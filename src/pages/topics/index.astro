---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import { collectTopics } from "../../data/topics.mjs";
import { collectionPageJsonLd } from "../../lib/seo.mjs";

const pub = (arr, collection) =>
  arr.filter((e) => e.data.reviewed).map((entry) => ({ collection, entry }));
const all = [
  ...pub(await getCollection("learn"), "learn"),
  ...pub(await getCollection("playbook"), "playbook"),
  ...pub(await getCollection("charts"), "charts"),
];
const topics = collectTopics(all).filter((t) => t.items.length > 0);
// テーマの所属セクション色。topics.mjs の grad 先頭色（セクション色）から引く。面では塗らず印の色にだけ使う
const SEC = { "#a3690f": "charts", "#1f6e50": "playbook", "#2b4a8b": "learn" };
const secOf = (t) => SEC[(t.grad.match(/#[0-9a-f]{6}/i) ?? [""])[0].toLowerCase()] ?? "learn";
const totalItems = new Set(topics.flatMap((t) => t.items.map(({ collection, entry }) => `${collection}/${entry.slug}`))).size;

// 一覧ページの構造化データ（CollectionPage + ItemList）
const jsonLd = [collectionPageJsonLd({
  path: "/topics/",
  name: "テーマ別に学ぶ｜投資の学び舎",
  description: "投資・トレードの記事をテーマ別にまとめた索引。",
  items: topics.map((t) => ({ url: `/topics/${t.slug}/`, name: t.title })),
})];
---
<Base
  title="テーマ別に学ぶ"
  description="テクニカル指標・チャートパターン・損切りと資金管理・相場心理など、テーマ別に記事をまとめています。関心のあるテーマから体系的に学べます。"
  pagebg={true}
  jsonLd={jsonLd}
>
  <header class="page-head">
    <div class="container-wide">
      <p class="eyebrow">Topics</p>
      <h1>テーマ別に学ぶ</h1>
      <p class="lead">章立て（<a href="/learn/">学習マップ</a>）が「教科書の順番」だとすれば、テーマ別は「関心からの入口」です。気になるテーマから読み始めて、関連記事へ横に広げてください。</p>
      <p class="count">{topics.length}テーマ ・ 対象記事 {totalItems}本（重複を除く）</p>
    </div>
  </header>
  <div class="container-wide body">
    <ul class="grid">
      {topics.map((t, i) => (
        <li>
          <a class={`tile sec-${secOf(t)}`} href={`/topics/${t.slug}/`}>
            <span class="seal" aria-hidden="true">{t.thumb}</span>
            <span class="tb">
              <span class="tt">{t.title}</span>
              <span class="ld">{t.lead}</span>
              <span class="tm"><span class="n">{t.items.length}本</span></span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
  <style>
    .body { padding-top: 1.8rem; padding-bottom: 4rem; }
    .grid {
      list-style: none; margin: 0; padding: 0;
      display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 330px), 1fr)); gap: .8rem;
    }
    .sec-learn { --tc: var(--color-sec-learn); }
    .sec-playbook { --tc: var(--color-sec-playbook); }
    .sec-charts { --tc: var(--color-sec-charts); }
    .tile {
      display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 1rem; align-items: start; height: 100%;
      text-decoration: none; color: var(--color-text);
      background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius);
      padding: 1.05rem 1.1rem 1rem; box-shadow: var(--shadow-card); min-height: 44px;
      transition: border-color .2s var(--ease), box-shadow .2s var(--ease);
    }
    .tile:hover { border-color: var(--color-border-strong); box-shadow: var(--shadow-float); }
    .tile:hover .tt { color: var(--color-accent); text-decoration: underline; text-decoration-thickness: 1px; }
    /* 印（はんこ）: 一文字をセクション色の細枠で囲む。面では塗らない */
    .seal {
      width: 52px; height: 52px; display: flex; align-items: center; justify-content: center;
      border: 1.5px solid var(--tc); border-radius: 4px; color: var(--tc);
      font-family: var(--font-display); font-weight: 800; font-size: 1.15rem; letter-spacing: 0;
      background: var(--color-paper);
      box-shadow: inset 0 0 0 3px var(--color-bg), inset 0 0 0 4px color-mix(in srgb, var(--tc) 30%, transparent);
    }
    .tb { display: flex; flex-direction: column; min-width: 0; height: 100%; }
    .tt { font-family: var(--font-display); font-weight: 800; color: var(--color-ink); font-size: 1.08rem; line-height: 1.45; }
    .ld { font-size: .8rem; color: var(--color-text-muted); line-height: 1.75; margin-top: .35rem; }
    .tm {
      display: flex; align-items: center; justify-content: flex-end; margin-top: auto; padding-top: .7rem;
      font-family: var(--font-num); font-size: .74rem; color: var(--color-text-muted);
    }
    .tm .n::after { content: " →"; color: var(--color-border-strong); }
    .tile:hover .tm .n::after { color: var(--color-accent); }
  </style>
</Base>
