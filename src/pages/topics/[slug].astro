---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import { collectTopics } from "../../data/topics.mjs";
import { collectionPageJsonLd, breadcrumbJsonLd } from "../../lib/seo.mjs";
import Breadcrumb from "../../components/Breadcrumb.astro";

export async function getStaticPaths() {
  const pub = (arr, collection) =>
    arr.filter((e) => e.data.reviewed).map((entry) => ({ collection, entry }));
  const all = [
    ...pub(await getCollection("learn"), "learn"),
    ...pub(await getCollection("playbook"), "playbook"),
    ...pub(await getCollection("charts"), "charts"),
  ];
  return collectTopics(all)
    .filter((t) => t.items.length > 0)
    .map((t) => ({ params: { slug: t.slug }, props: { topic: t } }));
}

const { topic } = Astro.props;
const CAT = {
  learn: { label: "学ぶ", cls: "cat-learn" },
  playbook: { label: "手法", cls: "cat-playbook" },
  charts: { label: "チャート", cls: "cat-charts" },
};
// テーマの所属セクション色（topics.mjs の grad 先頭色から引く。印の色にだけ使う）
const SEC = { "#a3690f": "charts", "#1f6e50": "playbook", "#2b4a8b": "learn" };
const sec = SEC[(topic.grad.match(/#[0-9a-f]{6}/i) ?? [""])[0].toLowerCase()] ?? "learn";
const ymd = (d) => new Date(d).toISOString().slice(0, 10);
const LEVELS = { 1: "入門", 2: "基礎", 3: "実践", 4: "上級" };
const bestGrade = (sources = []) =>
  ["A", "B", "C", "D"].find((g) => sources.some((s) => s.grade === g)) ?? null;
const fmt = (d) => ymd(d).replaceAll("-", ".");

// パンくずは画面表示と構造化データで同じ配列を共有する
const trail = [
  { name: "ホーム", url: "/" },
  { name: "テーマ別", url: "/topics/" },
  { name: topic.title, url: `/topics/${topic.slug}/` },
];
const jsonLd = [
  collectionPageJsonLd({
    path: `/topics/${topic.slug}/`,
    name: `${topic.title}の記事一覧｜投資の学び舎`,
    description: topic.lead,
    items: topic.items.map(({ collection, entry }) => ({
      url: `/${collection}/${entry.slug}/`,
      name: entry.data.title,
    })),
  }),
  breadcrumbJsonLd({ trail }),
];
---
<Base
  title={`${topic.title}の記事一覧`}
  description={`${topic.lead}（全${topic.items.length}本・出典付き）`}
  pagebg={true}
  jsonLd={jsonLd}
>
  <header class="page-head" style={`--eyebrow-dot:var(--color-sec-${sec})`}>
    <div class="container-wide">
      <Breadcrumb trail={trail} />
      <div class="head">
        <span class="seal" style={`--tc:var(--color-sec-${sec})`} aria-hidden="true">{topic.thumb}</span>
        <div class="head-b">
          <p class="eyebrow">Topic</p>
          <h1>{topic.title}</h1>
          <p class="lead">{topic.lead}</p>
          <p class="count">全{topic.items.length}本 ・ 更新日の新しい順</p>
        </div>
      </div>
    </div>
  </header>
  <div class="container-wide body">
    <ul class="post-list rows">
      {topic.items.map(({ collection, entry }) => (
        <li>
          <a class="post-link" href={`/${collection}/${entry.slug}/`}>
            <span class="pt">{entry.data.title}</span>
            <span class="pm">
              <span class={`cat ${CAT[collection].cls}`}>{CAT[collection].label}</span>
              {(entry.data.chapter ?? entry.data.kind ?? entry.data.patternType) && (
                <span class="sub">{entry.data.chapter ?? entry.data.kind ?? entry.data.patternType}</span>
              )}
              {entry.data.level && <span class="bg bg-lv">Lv.{entry.data.level} {LEVELS[entry.data.level]}</span>}
              {bestGrade(entry.data.sources) && <span class="bg bg-src">出典{bestGrade(entry.data.sources)}</span>}
              <time datetime={ymd(entry.data.updated)}>{fmt(entry.data.updated)} 更新</time>
            </span>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="back"><a href="/topics/">← 他のテーマを見る</a></p>
  </div>
  <style>
    .page-head :global(.breadcrumb) { margin-bottom: 1.2rem; }
    .head { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 1.2rem; align-items: start; }
    .head .eyebrow { margin-bottom: .35rem; }
    .seal {
      width: 64px; height: 64px; display: flex; align-items: center; justify-content: center; margin-top: .2rem;
      border: 1.5px solid var(--tc); border-radius: 4px; color: var(--tc); background: var(--color-bg);
      font-family: var(--font-display); font-weight: 800; font-size: 1.45rem;
      box-shadow: inset 0 0 0 3px var(--color-bg), inset 0 0 0 4px color-mix(in srgb, var(--tc) 30%, transparent);
    }
    .body { padding-top: 1.6rem; padding-bottom: 4rem; }
    .rows {
      background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius);
      box-shadow: var(--shadow-card); padding: 0 1.2rem;
    }
    .rows .post-link { padding: .85rem .1rem; min-height: 44px; }
    .sub { color: var(--color-text-muted); }
    .sub::after { content: ""; display: inline-block; width: 1px; height: .8em; background: var(--color-border); margin-left: .6rem; vertical-align: -.05em; }
    .back { margin: 1.4rem 0 0; font-size: .88rem; }
    .back a { display: inline-flex; align-items: center; min-height: 44px; font-weight: 700; text-decoration: none; }
    .back a:hover { text-decoration: underline; }
    @media (max-width: 560px) {
      .head { gap: .8rem; }
      .seal { width: 44px; height: 44px; font-size: 1rem; margin-top: 0; }
      .rows { padding: 0 .85rem; }
    }
  </style>
</Base>
