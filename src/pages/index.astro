---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import { collectTopics } from "../data/topics.mjs";
import { orderedEntries } from "../lib/sequence.mjs";

const pub = (arr) => arr.filter((e) => e.data.reviewed);
const learn = pub(await getCollection("learn")).sort((a, b) => a.data.order - b.data.order);
const playbook = pub(await getCollection("playbook"));
const charts = pub(await getCollection("charts"));
const glossary = pub(await getCollection("glossary"));
const books = pub(await getCollection("books"));
const published = learn.length + playbook.length + charts.length + glossary.length + books.length;

// 記事行の共通整形。バッジは frontmatter の実データのみから生成する（根拠のない表示はしない）
const LEVELS = { 1: "入門", 2: "基礎", 3: "実践", 4: "上級" };
const bestGrade = (sources = []) =>
  ["A", "B", "C", "D"].find((g) => sources.some((s) => s.grade === g)) ?? null;
const row = (entry, base, cat, catClass) => ({
  href: `${base}${entry.slug}/`,
  title: entry.data.title,
  cat,
  catClass,
  level: entry.data.level ? `Lv.${entry.data.level} ${LEVELS[entry.data.level]}` : null,
  grade: bestGrade(entry.data.sources),
  sub: entry.data.chapter ?? entry.data.kind ?? entry.data.patternType ?? null,
  updated: new Date(entry.data.updated),
});
const byUpdated = (a, b) => b.updated - a.updated;
const secLearn = learn.map((e) => row(e, "/learn/", "学ぶ", "cat-learn"));
const secPlay = playbook.map((e) => row(e, "/playbook/", "手法・定石", "cat-playbook"));
const secChart = charts.map((e) => row(e, "/charts/", "チャート図解", "cat-charts"));
const secGlos = glossary.map((e) => row(e, "/glossary/", "用語集", "cat-glossary"));
// おすすめ書籍はPRコンテンツのため「新着・更新」には混ぜない（教育記事を優先）
const secBooks = books
  .sort((a, b) => a.data.order - b.data.order)
  .map((e) => ({ ...row(e, "/books/", "書籍", "cat-books"), sub: e.data.bookCategory }));

// 新着・更新 = 教育コンテンツ横断・更新日降順
const latest = [...secLearn, ...secPlay, ...secChart, ...secGlos].sort(byUpdated).slice(0, 7);
const newest = latest.length ? latest[0].updated : null;
const ymd = (d) => `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, "0")}.${String(d.getDate()).padStart(2, "0")}`;

// 最初に読む3本 = 学習マップと同じ「読む順序」（章→レベル→order / src/lib/sequence.mjs）で最初の Lv.1 記事3本
const firstThree = orderedEntries("learn", learn).filter((e) => e.data.level === 1).slice(0, 3);

// 学習の時間割（7章 × 4レベル）。セルの本数・先頭記事は実データから数える
const CHAPTERS = [
  "お金と市場の基礎", "商品と制度", "リスク管理", "分析手法",
  "法規制とルール", "行動と心理", "テクノロジーと自動化",
];
const timetable = CHAPTERS.map((chapter, i) => {
  const items = learn.filter((e) => e.data.chapter === chapter);
  return {
    n: i + 1,
    chapter,
    total: items.length,
    cells: [1, 2, 3, 4].map((lv) => {
      const hit = items.filter((e) => e.data.level === lv);
      return { lv, count: hit.length, first: hit[0] ?? null };
    }),
  };
});

// テーマから探す（横断カテゴリ・frontmatter実データのみで分類）
const topicTiles = collectTopics([
  ...learn.map((entry) => ({ collection: "learn", entry })),
  ...playbook.map((entry) => ({ collection: "playbook", entry })),
  ...charts.map((entry) => ({ collection: "charts", entry })),
]).filter((t) => t.items.length > 0);

// 用語ピックアップ（最新の用語1件）
const pickWord = glossary.length
  ? [...glossary].sort((a, b) => new Date(b.data.updated) - new Date(a.data.updated))[0]
  : null;

const shelves = [
  { title: "学ぶ", sub: "市場と制度の基礎", href: "/learn/", rows: secLearn.slice(0, 4), color: "var(--color-sec-learn)", count: learn.length },
  { title: "手法・定石", sub: "前提と限界つきで", href: "/playbook/", rows: secPlay.slice(0, 4), color: "var(--color-sec-playbook)", count: playbook.length },
  { title: "チャート図解", sub: "形と指標を図で", href: "/charts/", rows: secChart.slice(0, 4), color: "var(--color-sec-charts)", count: charts.length },
  { title: "おすすめ書籍", sub: "定番書を選び方つきで", href: "/books/", rows: secBooks.slice(0, 4), color: "var(--color-sec-books)", count: books.length },
];

// ── ヒーローの模式図（実在銘柄ではない）──────────────────────────────
// 上昇 → ダブルトップ → ネックライン割れ の教科書的な形。終値列は手で設計した固定値で、
// ビルドごとに形が変わらない（＝表示がぶれない・CLSなし）。
const closes = [100, 104, 101, 107, 111, 109, 115, 120, 117, 123, 128, 126, 133, 127, 122, 119, 124, 129, 132, 125, 120, 116, 113, 117, 111, 106, 108, 103];
const VB_W = 620, VB_H = 460, PAD_T = 70, PAD_B = 20;
const lo = 92, hi = 138;
const yOf = (p) => PAD_T + ((hi - p) / (hi - lo)) * (VB_H - PAD_T - PAD_B);
const step = 21;
const x0 = 18;
const candles = closes.map((c, i) => {
  const o = i === 0 ? 97 : closes[i - 1];
  const wickUp = 1.2 + ((i * 7) % 5) * 0.55;
  const wickDn = 1.0 + ((i * 3) % 4) * 0.6;
  const top = Math.max(o, c), bot = Math.min(o, c);
  return {
    i,
    up: c >= o,
    x: x0 + i * step,
    yHigh: yOf(top + wickUp),
    yLow: yOf(bot - wickDn),
    yTop: yOf(top),
    h: Math.max(2, yOf(bot) - yOf(top)),
  };
});
const cx = (i) => x0 + i * step;
const neckY = yOf(119);
const top1 = { x: cx(12), y: yOf(135.2) };
const top2 = { x: cx(18), y: yOf(134.4) };
---
<Base
  fullTitle="投資の学び舎（まなびや）｜投資・トレードを基礎から学ぶ"
  title="投資の学び舎（まなびや）"
  description="投資家・トレーダーのための教育サイト。煽らず、断定せず、一次情報に基づいて、レベル別・出典付きで解説します。チャート図解・手法と定石・用語集まで無料で公開中。"
  pagebg={true}
>
  <!-- ヒーロー: 方眼の罫線帳に、赤ペンで添削の入ったチャート（サイトの主題そのもの） -->
  <section class="hero" aria-labelledby="hero-h">
    <div class="container-wide hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">投資・トレードの教科書サイト</p>
        <h1 id="hero-h">
          <span class="h1-main">相場を、<br />正しく学ぶ。</span>
          <span class="h1-sub">投資・トレードを基礎から、出典付きで。</span>
        </h1>
        <p class="hero-lead">煽らず、断定せず、一次情報に基づいて。市場の仕組みからチャートの読み方、損切りの設計まで、<b>{published}本</b>の記事を<b>7章×4レベル</b>の時間割で公開しています。</p>
        <div class="hero-actions">
          {firstThree[0] && (
            <a class="btn btn-primary" href={`/learn/${firstThree[0].slug}/`}>入門の1本目から読む<span aria-hidden="true">→</span></a>
          )}
          <a class="btn btn-ghost" href="#timetable">時間割を見る</a>
        </div>
        <p class="hero-words">
          <span>よく引かれる言葉</span>
          {["複利", "損切り", "NISA", "ダブルトップ", "ボラティリティ"].map((w) => (
            <a href={`/search/?q=${encodeURIComponent(w)}`}>{w}</a>
          ))}
        </p>
      </div>

      <figure class="hero-chart">
        <svg viewBox={`0 0 ${VB_W} ${VB_H}`} role="img" aria-labelledby="hc-t">
          <title id="hc-t">模式図: 上昇のあとダブルトップを作り、ネックラインを割り込むまでのローソク足。赤ペンで形の名前が書き込まれている</title>
          <g class="candles">
            {candles.map((k) => (
              <g class={`k ${k.up ? "k-up" : "k-dn"}`} style={`--i:${k.i}`}>
                <line x1={k.x} x2={k.x} y1={k.yHigh} y2={k.yLow} />
                <rect x={k.x - 5.5} y={k.yTop} width="11" height={k.h} rx="1" />
              </g>
            ))}
          </g>
          {/* 赤ペン: ネックライン */}
          <g class="pen pen-1">
            <path d={`M ${cx(13) - 8} ${neckY} L ${cx(27) + 14} ${neckY}`} pathLength="1" class="pen-dash" />
            <text x={cx(23) + 4} y={neckY - 10} class="pen-label">ネックライン</text>
          </g>
          {/* 赤ペン: 2つの山を丸で囲む（手書きの揺れを残したパス） */}
          <g class="pen pen-2">
            <path pathLength="1" d={`M ${top1.x - 18} ${top1.y + 6} C ${top1.x - 20} ${top1.y - 22}, ${top1.x + 22} ${top1.y - 26}, ${top1.x + 19} ${top1.y + 2} C ${top1.x + 17} ${top1.y + 24}, ${top1.x - 16} ${top1.y + 24}, ${top1.x - 19} ${top1.y + 1}`} />
            <path pathLength="1" d={`M ${top2.x - 19} ${top2.y + 4} C ${top2.x - 18} ${top2.y - 24}, ${top2.x + 21} ${top2.y - 24}, ${top2.x + 18} ${top2.y + 4} C ${top2.x + 16} ${top2.y + 25}, ${top2.x - 17} ${top2.y + 22}, ${top2.x - 20} ${top2.y}`} />
            <path pathLength="1" d={`M ${top1.x + 6} ${top1.y - 24} Q ${(top1.x + top2.x) / 2} ${top1.y - 52}, ${top2.x - 6} ${top2.y - 24}`} />
            <text x={(top1.x + top2.x) / 2} y={top1.y - 46} text-anchor="middle" class="pen-label pen-label-l">ダブルトップ</text>
          </g>
          {/* 赤ペン: ネックライン割れで形が完成 */}
          <g class="pen pen-3">
            <path pathLength="1" d={`M ${cx(17)} ${neckY + 92} Q ${cx(20) + 2} ${neckY + 90}, ${cx(21) - 2} ${neckY + 24}`} />
            <path pathLength="1" d={`M ${cx(21) - 10} ${neckY + 31} L ${cx(21) - 2} ${neckY + 21} L ${cx(21) + 5} ${neckY + 32}`} />
            <text x={cx(17) - 6} y={neckY + 98} text-anchor="end" class="pen-label">割れて形が完成</text>
          </g>
        </svg>
        <figcaption>模式図（実在の銘柄・相場ではありません）。形の見方は<a href="/charts/">チャート図解</a>で。</figcaption>
      </figure>
    </div>
  </section>

  <!-- 帳簿の一行: 実データの事実だけを並べる（水増ししない） -->
  <div class="ledger" role="list" aria-label="サイトの現況">
    <div class="container-wide ledger-row">
      <p role="listitem"><span>公開記事</span><b>{published}</b>本</p>
      <p role="listitem"><span>カリキュラム</span><b>7</b>章×<b>4</b>レベル</p>
      <p role="listitem"><span>出典</span>全記事に等級つきで明記</p>
      {newest && <p role="listitem"><span>最終更新</span><time datetime={newest.toISOString()}>{ymd(newest)}</time></p>}
    </div>
  </div>

  <div class="container-wide home">

    <!-- 最初に読む3本（学習マップの並びそのもの＝順序に意味がある） -->
    {firstThree.length > 0 && (
      <section class="first" aria-labelledby="first-h">
        <div class="sec-head">
          <h2 id="first-h">はじめての方は、この3本から</h2>
          <span class="sec-sub">学習マップの順番どおり、最初のLv.1記事から</span>
          <a class="more" href="/learn/?lv=1">Lv.1の記事をすべて見る</a>
        </div>
        <ol class="first-list">
          {firstThree.map((e, i) => (
            <li>
              <a href={`/learn/${e.slug}/`}>
                <span class="first-no" aria-hidden="true">{i + 1}</span>
                <span class="first-ch">{e.data.chapter}</span>
                <span class="first-title">{e.data.title}</span>
                <span class="first-meta">
                  <span class="bg bg-lv">Lv.1 入門</span>
                  {bestGrade(e.data.sources) && <span class="bg bg-src">出典{bestGrade(e.data.sources)}</span>}
                </span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    )}

    <!-- 学習の時間割: 7章×4レベル。セルは実際の本数と先頭記事 -->
    <section class="tt-sec" id="timetable" aria-labelledby="tt-h">
      <div class="sec-head">
        <h2 id="tt-h">学習の時間割</h2>
        <span class="sec-sub">7つの章を、入門から上級まで4段階で</span>
        <a class="more" href="/learn/">学習マップを開く</a>
      </div>
      <div class="tt">
        <div class="tt-row tt-head" aria-hidden="true">
          <span class="tt-corner">章 ＼ レベル</span>
          {[1, 2, 3, 4].map((lv) => (
            <span><b>Lv.{lv}</b>{LEVELS[lv]}</span>
          ))}
        </div>
        {timetable.map((r) => (
          <div class="tt-row">
            <a class="tt-ch" href={`/learn/#ch-${r.n}`}>
              <span class="tt-n">第{r.n}章</span>
              <span class="tt-name">{r.chapter}</span>
              <span class="tt-total">{r.total}本</span>
            </a>
            {r.cells.map((c) => (
              c.count > 0 ? (
                <a class="tt-cell" href={`/learn/?lv=${c.lv}#ch-${r.n}`} data-lv={`Lv.${c.lv} ${LEVELS[c.lv]}`}>
                  <span class="sr">第{r.n}章 Lv.{c.lv} {LEVELS[c.lv]}：</span>
                  <span class="tt-count"><b>{c.count}</b>本</span>
                  <span class="tt-first">{c.first.data.title}</span>
                </a>
              ) : (
                <span class="tt-cell tt-empty" data-lv={`Lv.${c.lv} ${LEVELS[c.lv]}`}>
                  <span class="tt-count">準備中</span>
                </span>
              )
            ))}
          </div>
        ))}
      </div>
    </section>

    <!-- テーマから探す -->
    <section aria-labelledby="topic-h">
      <div class="sec-head">
        <h2 id="topic-h">テーマから探す</h2>
        <span class="sec-sub">章をまたいで、目的別に</span>
        <a class="more" href="/topics/">すべてのテーマ</a>
      </div>
      <ul class="topic-grid">
        {topicTiles.map((t) => (
          <li>
            <a class="topic-tile" href={`/topics/${t.slug}/`}>
              <span class="topic-thumb" aria-hidden="true">{t.thumb}</span>
              <span class="topic-name">{t.title}</span>
              <span class="topic-count">{t.items.length}<small>本</small></span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- 新着・更新 ＋ 右: 用語ピックアップと編集方針 -->
    <div class="split">
      <section aria-labelledby="latest-h">
        <div class="sec-head">
          <h2 id="latest-h">新着・更新</h2>
          {newest && <span class="sec-sub"><time datetime={newest.toISOString()}>{ymd(newest)}</time> 更新</span>}
        </div>
        <ul class="post-list latest">
          {latest.map((r) => (
            <li>
              <a class="post-link" href={r.href}>
                <span class="pt">{r.title}</span>
                <span class="pm">
                  <span class={`cat ${r.catClass}`}>{r.cat}</span>
                  {r.level && <span class="bg bg-lv">{r.level}</span>}
                  {r.grade && <span class="bg bg-src">出典{r.grade}</span>}
                  <time datetime={r.updated.toISOString()}>{ymd(r.updated)}</time>
                </span>
                <span class="arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <aside class="rail" aria-label="用語と編集方針">
        {pickWord && (
          <section class="word card" aria-labelledby="word-h">
            <p class="eyebrow" style="--eyebrow-dot:var(--color-sec-glossary)">今日の用語</p>
            <h2 id="word-h" class="word-term">
              <a href={`/glossary/${pickWord.slug}/`}>{pickWord.data.term}</a>
            </h2>
            {pickWord.data.reading && <p class="word-read">{pickWord.data.reading}</p>}
            <p class="word-desc">{pickWord.data.description}</p>
            <a class="word-more" href="/glossary/">用語集をひく（{glossary.length}語）</a>
          </section>
        )}
        <section class="promise" aria-labelledby="promise-h">
          <h2 id="promise-h">このサイトの約束</h2>
          <ul>
            <li><b>出典を等級で明示</b>事実の主張にはA〜Cの出典を最低1件。資料がなければ「E＝編集部調べ」と正直に書きます。</li>
            <li><b>断定しない</b>「必ず儲かる」は書きません。手法には前提条件と限界を添えます。</li>
            <li><b>更新日を必ず表示</b>制度や相場は変わります。すべての記事に更新日とレビュー日を載せます。</li>
          </ul>
          <dl class="grades">
            <div><dt>A</dt><dd>公的機関・取引所</dd></div>
            <div><dt>B</dt><dd>学術</dd></div>
            <div><dt>C</dt><dd>企業の一次発表</dd></div>
            <div><dt>D</dt><dd>報道</dd></div>
          </dl>
          <a class="promise-more" href="/policy/">編集方針を読む</a>
        </section>
      </aside>
    </div>

    <!-- 書架: コレクション別 -->
    <section aria-labelledby="shelf-h">
      <div class="sec-head">
        <h2 id="shelf-h">分野別の書架</h2>
        <span class="sec-sub">4つの棚から、最新の4本ずつ</span>
      </div>
      <div class="shelves">
        {shelves.map((s) => (
          <section class="shelf" style={`--shelf:${s.color}`} aria-label={s.title}>
            <header class="shelf-head">
              <h3><a href={s.href}>{s.title}</a></h3>
              <span class="shelf-sub">{s.sub}</span>
              <span class="shelf-count">{s.count}<small>本</small></span>
            </header>
            {s.rows.length === 0 ? <p class="empty">準備中です。</p> : (
              <ul class="post-list">
                {s.rows.map((r) => (
                  <li>
                    <a class="post-link" href={r.href}>
                      <span class="pt">{r.title}</span>
                      <span class="pm">
                        {r.sub && <span>{r.sub}</span>}
                        {r.level && <span class="bg bg-lv">{r.level}</span>}
                        {r.grade && <span class="bg bg-src">出典{r.grade}</span>}
                      </span>
                      <span class="arrow" aria-hidden="true">→</span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
            <a class="shelf-more" href={s.href}>{s.title}の一覧へ</a>
          </section>
        ))}
      </div>
    </section>

  </div>

  <style>
    /* ── ヒーロー ─────────────────────────────── */
    .hero {
      background: var(--grid-paper);
      border-bottom: 1px solid var(--color-grid-strong);
      overflow: hidden;
    }
    .hero-grid {
      display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      gap: clamp(1.5rem, 4vw, 3.5rem); align-items: center;
      padding-top: clamp(2.2rem, 6vw, 4.5rem); padding-bottom: clamp(2rem, 5vw, 3.5rem);
    }
    .hero h1 { margin: 0 0 1.2rem; }
    .h1-main {
      display: block; font-family: var(--font-display); font-weight: 800;
      font-size: clamp(2.6rem, 6.4vw, 4.9rem); line-height: 1.18; letter-spacing: .02em;
      color: var(--color-ink);
    }
    .h1-sub {
      display: block; margin-top: 1rem; font-size: clamp(1rem, 1.8vw, 1.2rem); font-weight: 700;
      letter-spacing: .06em; color: var(--color-ink);
    }
    .hero-lead { margin: 0 0 1.6rem; font-size: 1rem; line-height: 1.9; max-width: 34em; }
    .hero-lead b { font-weight: 700; color: var(--color-ink); }
    .hero-actions { display: flex; flex-wrap: wrap; gap: .7rem; margin-bottom: 1.5rem; }
    .hero-actions .btn-primary span { transition: transform .2s var(--ease); }
    .hero-actions .btn-primary:hover span { transform: translateX(3px); }

    .hero-words { display: flex; flex-wrap: wrap; align-items: center; gap: .4rem .5rem; margin: 0; font-size: .8rem; }
    .hero-words span { color: var(--color-text-muted); margin-right: .2rem; }
    .hero-words a {
      text-decoration: none; padding: .25rem .65rem; border-radius: 999px; min-height: 32px;
      display: inline-flex; align-items: center;
      border: 1px solid var(--color-border-strong); background: var(--color-bg); color: var(--color-ink);
    }
    .hero-words a:hover { border-color: var(--color-accent); color: var(--color-accent); }

    /* 模式図 */
    .hero-chart { margin: 0 calc(var(--gutter) * -0.5) 0 0; }
    .hero-chart svg { display: block; width: 100%; height: auto; aspect-ratio: 620 / 460; overflow: visible; }
    .hero-chart figcaption { font-size: .8rem; color: var(--color-text-muted); margin-top: .4rem; text-align: right; }
    .k line { stroke-width: 1.4; }
