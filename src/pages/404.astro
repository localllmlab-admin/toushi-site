---
/**
 * 404ページ。
 * Nginxの既定404はサイト外の見た目になり、そこで離脱する。
 * 主要導線を置いて回遊に戻し、noindexでインデックスさせない。
 */
import Base from "../layouts/Base.astro";

const ENTRIES = [
  { href: "/learn/", label: "学習マップ", note: "7章×4レベルで体系的に学ぶ" },
  { href: "/topics/", label: "テーマ別に学ぶ", note: "関心のあるテーマから入る" },
  { href: "/charts/", label: "チャート図解", note: "パターン・指標の見方" },
  { href: "/playbook/", label: "手法・定石・格言", note: "前提と限界つき" },
  { href: "/glossary/", label: "用語集", note: "用語の意味と使われ方" },
  { href: "/books/", label: "おすすめ書籍", note: "定番書を選び方つきで" },
];
---
<Base
  title="ページが見つかりません"
  description="お探しのページは見つかりませんでした。学習マップ・テーマ別・用語集・サイト内検索からお探しください。"
  noindex={true}
>
  <div class="container nf">
    <p class="code">404</p>
    <h1>ページが見つかりませんでした</h1>
    <p class="lead">
      URLが変更されたか、削除された可能性があります。以下の入口かサイト内検索からお探しください。
    </p>
    <p class="cta"><a href="/search/">サイト内検索でさがす</a></p>
    <ul class="entries">
      {ENTRIES.map((e) => (
        <li>
          <a href={e.href}>
            <span class="label">{e.label}</span>
            <span class="note">{e.note}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="back"><a href="/">← トップページへ戻る</a></p>
  </div>
  <style>
    .nf { padding: 3rem 1.25rem 4rem; max-width: 46rem; }
    .code {
      font-family: var(--font-num); font-size: 3rem; font-weight: 800;
      color: var(--color-border-strong); margin: 0; line-height: 1;
    }
    h1 { margin: .4rem 0 0; font-size: 1.5rem; }
    .lead { color: var(--color-text-muted); line-height: 1.9; }
    .cta { margin: 1.4rem 0 0; }
    .cta a {
      display: inline-block; font-weight: 800; text-decoration: none;
      background: var(--color-cta); color: #fff;
      padding: .7rem 1.4rem; border-radius: var(--radius); min-height: 44px;
    }
    .cta a:hover { filter: brightness(1.05); }
    .entries {
      list-style: none; padding: 0; margin: 2rem 0 0;
      display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: .7rem;
    }
    .entries a {
      display: block; height: 100%; text-decoration: none; color: var(--color-text);
      border: 1px solid var(--color-border); border-radius: var(--radius);
      background: var(--color-bg); padding: .8rem .95rem;
    }
    .entries a:hover { border-color: var(--color-accent); }
    .label { display: block; font-weight: 800; font-size: .95rem; }
    .note { display: block; font-size: .78rem; color: var(--color-text-muted); margin-top: .2rem; }
    .back { margin-top: 2rem; font-size: .88rem; }
    .back a { font-weight: 700; text-decoration: none; }
    .back a:hover { text-decoration: underline; }
  </style>
</Base>
