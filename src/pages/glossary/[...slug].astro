---
import Article from "../../layouts/Article.astro";
import { getCollection } from "astro:content";
import { matchKeysOf, textMentions } from "../../lib/glossary.mjs";
export async function getStaticPaths() {
  // reviewed:true のみ公開（未レビュー自動生成物を除外）
  const items = (await getCollection("glossary")).filter((e) => e.data.reviewed);
  return items.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await entry.render();
// 用語集固有: 読み仮名と関連用語（related は用語名の配列。スラッグ解決は名称一致で行う）
const all = (await getCollection("glossary")).filter((e) => e.data.reviewed);
const related = (entry.data.related ?? [])
  .map((name) => all.find((e) => e.data.term === name))
  .filter(Boolean);
// この用語が出てくる記事（本文の実データからの逆引き・最大5件 / WO-TOUSHI-002(a)）
// 語境界判定は本文の自動リンク（rehype-glossary-links）と同一（src/lib/glossary.mjs）
const keys = matchKeysOf(entry.data.term);
const usedIn = [];
for (const [collection, entries] of [
  ["learn", await getCollection("learn")],
  ["playbook", await getCollection("playbook")],
  ["charts", await getCollection("charts")],
]) {
  for (const e of entries) {
    if (e.data.reviewed && textMentions(e.body, keys)) usedIn.push({ collection, e });
  }
}
usedIn.sort((a, b) => new Date(b.e.data.updated) - new Date(a.e.data.updated));
const usedInTop = usedIn.slice(0, 5);
---
<Article entry={entry} headings={headings}>
  {entry.data.reading && <p class="reading">読み：{entry.data.reading}</p>}
  <Content />
  {related.length > 0 && (
    <aside class="related">
      <h2>関連用語</h2>
      <ul>{related.map((r) => (
        <li><a href={`/glossary/${r.slug}/`}>{r.data.term}</a> ― {r.data.description}</li>
      ))}</ul>
    </aside>
  )}
  {usedInTop.length > 0 && (
    <aside class="used-in">
      <h2>この用語が出てくる記事</h2>
      <ul>{usedInTop.map(({ collection, e }) => (
        <li><a href={`/${collection}/${e.slug}/`}>{e.data.title}</a></li>
      ))}</ul>
    </aside>
  )}
</Article>
<style is:global>
  /* 用語集の固有部品。Article.astro の .body h2 罫を上書きするため、クラスを重ねて詳細度を確保する */
  .reading {
    display: inline-flex; align-items: center; gap: .5em;
    color: var(--color-text-muted); font-size: .8rem; font-family: var(--font-mono); letter-spacing: .06em;
    margin-top: -0.5rem;
  }
  .reading::before { content: ""; width: 6px; height: 6px; border-radius: 2px; background: var(--color-sec-glossary); }
  .related.related, .used-in.used-in {
    margin-top: 2rem; background: var(--color-bg); border: 1px solid var(--color-border);
    border-radius: var(--radius); box-shadow: var(--shadow-card); padding: 1rem 1.2rem .6rem;
  }
  .related.related { border-top: 2px solid var(--color-sec-glossary); }
  .used-in.used-in { margin-top: 1.2rem; border-top: 2px solid var(--color-ink); }
  aside.related.related > h2, aside.used-in.used-in > h2 {
    font-family: var(--font-display); font-weight: 800; font-size: 1.05rem;
    margin: 0 0 .3rem; padding: 0; border: none; position: static;
  }
  aside.related.related > h2::before, aside.used-in.used-in > h2::before { content: none; }
  .related.related ul, .used-in.used-in ul { list-style: none; margin: 0; padding: 0; font-size: .9rem; }
  .related.related li, .used-in.used-in li {
    margin: 0; padding: .55rem 0; border-top: 1px solid var(--color-border); line-height: 1.7;
  }
  .related.related li:first-child, .used-in.used-in li:first-child { border-top: none; }
  .related.related li { color: var(--color-text-muted); font-size: .85rem; }
  .related.related a { font-family: var(--font-display); font-weight: 800; font-size: .98rem; text-decoration: none; }
  .used-in.used-in a { font-weight: 700; text-decoration: none; color: var(--color-ink); }
  .related.related a:hover, .used-in.used-in a:hover { color: var(--color-accent); text-decoration: underline; }
</style>
