---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import { collectionPageJsonLd } from "../../lib/seo.mjs";
const CATS = ["トレード実践", "相場心理", "投資の名著・古典", "インデックス投資・資産形成", "編集長おすすめ小説"];
const all = (await getCollection("books")).filter((e) => e.data.reviewed);
const byCat = CATS.map((c) => ({
  cat: c,
  items: all.filter((e) => e.data.bookCategory === c).sort((a, b) => a.data.order - b.data.order),
})).filter(({ items }) => items.length > 0);
const coverUrl = (isbn10) => `https://images-na.ssl-images-amazon.com/images/P/${isbn10}.09._SL500_.jpg`;

// 一覧ページの構造化データ（CollectionPage + ItemList）
const jsonLd = [collectionPageJsonLd({
  path: "/books/",
  name: "投資・トレードのおすすめ書籍｜投資の学び舎",
  description: "投資・トレードの定番書・名著を対象読者レベルつきで紹介する書籍ガイド。",
  items: byCat.flatMap((c) => c.items).map((e) => ({ url: `/books/${e.slug}/`, name: e.data.title })),
})];
---
<Base
  title="投資・トレードのおすすめ書籍"
  description="投資・トレードの定番書・名著を、対象読者レベルと「何に役立つか」つきで紹介します。編集部が内容を確認したうえで、評価を広告報酬で変えずに掲載しています。"
  pagebg={true}
  jsonLd={jsonLd}
>
  <header class="page-head" style="--eyebrow-dot:var(--color-sec-books)">
    <div class="container-wide">
      <p class="eyebrow">Books</p>
      <!-- PR表記: 広告リンクを含むページの上部に常時表示（ステマ規制対応 / ADR-0003） -->
      <p class="pr-note">本ページにはアフィリエイト広告（PR）が含まれます</p>
      <h1>おすすめ書籍</h1>
      <p class="lead">
        投資・トレードの定番書・名著を、「なぜ読む価値があるのか」「どのレベルの読者向けか」「何に役立つのか」まで踏み込んで紹介します。
        掲載の評価・順序を広告報酬によって変えることはありません（<a href="/policy/">編集方針</a>）。
      </p>
      <p class="count">掲載 {byCat.reduce((n, c) => n + c.items.length, 0)}冊 ・ {byCat.length}分類</p>
    </div>
  </header>
  <div class="container-wide body">
    {byCat.map(({ cat, items }) => (
      <section class="shelf">
        <div class="sec-head">
          <h2>{cat}</h2>
          <span class="sec-sub">{items.length}冊</span>
        </div>
        <ul class="book-grid">
          {items.map((e) => (
            <li class="book-item">
              <a href={`/books/${e.slug}/`}>
                <span class="thumb">
                  <img
                    src={coverUrl(e.data.isbn10)}
                    alt={`『${e.data.bookTitle}』書影`}
                    loading="lazy"
                    decoding="async"
                    onerror="this.parentElement.classList.add('noimg')"
                  />
                </span>
                <span class="info">
                  <span class="btitle">{e.data.bookTitle}</span>
                  <span class="bauthor">{e.data.bookAuthor}</span>
                  <span class="blevel"><span class="blevel-k">対象</span>{e.data.readerLevel}</span>
                  <span class="bdesc">{e.data.description}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
    <p class="associate-note">Amazonのアソシエイトとして、投資の学び舎（まなびや）は適格販売により収入を得ています。</p>
  </div>
</Base>
<style>
  .pr-note {
    display: block; width: fit-content;
    font-size: .76rem; font-weight: 700;
    color: var(--color-text-muted);
    background: var(--color-bg);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-s);
    padding: .25em .75em; margin: 0 0 .9rem;
  }
  .body { padding-top: .6rem; padding-bottom: 4rem; }
  .shelf { margin-top: 2.2rem; }
  .shelf .sec-head h2::before {
    content: ""; display: inline-block; width: .5rem; height: .5rem; border-radius: 2px;
    background: var(--color-sec-books); margin-right: .55rem; vertical-align: .2em;
  }
  .book-grid {
    list-style: none; padding: 0; margin: 0;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); gap: .9rem;
  }
  .book-item a {
    display: grid; grid-template-columns: 88px minmax(0, 1fr); gap: 1rem; height: 100%;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
    padding: 1rem 1.05rem;
    text-decoration: none; color: var(--color-text);
    transition: border-color .2s var(--ease), box-shadow .2s var(--ease);
  }
  .book-item a:hover { border-color: var(--color-border-strong); box-shadow: var(--shadow-float); }
  .book-item a:hover .btitle { color: var(--color-accent); text-decoration: underline; text-decoration-thickness: 1px; }
  .thumb {
    width: 88px; aspect-ratio: 5 / 7; align-self: start;
    display: flex; align-items: center; justify-content: center;
    border: 1px solid var(--color-border); border-radius: 2px;
    background: var(--color-surface); overflow: hidden;
    box-shadow: 2px 2px 0 var(--color-surface-muted);
  }
  .thumb img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .thumb.noimg img { display: none; }
  .info { display: flex; flex-direction: column; gap: .25rem; min-width: 0; }
  .btitle { font-weight: 700; font-size: 1rem; line-height: 1.5; color: var(--color-ink); }
  .bauthor { font-size: .78rem; color: var(--color-text-muted); }
  .blevel {
    display: flex; gap: .45rem; align-items: baseline;
    font-size: .74rem; font-weight: 700; color: var(--color-sec-books); line-height: 1.5; margin-top: .15rem;
  }
  .blevel-k {
    flex-shrink: 0; font-size: .64rem; padding: 0 .4em; border: 1px solid currentColor; border-radius: 2px;
  }
  .bdesc {
    font-size: .8rem; color: var(--color-text-muted); line-height: 1.7; margin-top: .2rem;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }
  .associate-note {
    font-size: .74rem; color: var(--color-text-muted);
    border-top: 1px solid var(--color-border);
    margin-top: 2.6rem; padding-top: .8rem;
  }
  @media (max-width: 480px) {
    .book-item a { grid-template-columns: 72px minmax(0, 1fr); gap: .85rem; padding: .9rem; }
    .thumb { width: 72px; }
  }
</style>
