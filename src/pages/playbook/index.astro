---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import { collectionPageJsonLd } from "../../lib/seo.mjs";
const KINDS = ["定石", "手法", "リスク管理", "心理", "格言"];
const all = (await getCollection("playbook")).filter((e) => e.data.reviewed);
const groups = KINDS.map((k, i) => ({ kind: k, id: `kind-${i + 1}`, items: all.filter((e) => e.data.kind === k) }))
  .filter((g) => g.items.length > 0);
// 出典等級・更新日は frontmatter の実データからのみ生成する（docs/tone.md）
const bestGrade = (sources = []) =>
  ["A", "B", "C", "D"].find((g) => sources.some((s) => s.grade === g)) ?? null;
const ymd = (d) => new Date(d).toISOString().slice(0, 10);
const fmt = (d) => ymd(d).replaceAll("-", ".");

// 一覧ページの構造化データ（CollectionPage + ItemList）
const jsonLd = [collectionPageJsonLd({
  path: "/playbook/",
  name: "手法・定石・格言｜投資の学び舎",
  description: "取引手法・相場の定石・格言のリファレンス。",
  items: KINDS.flatMap((k) => all.filter((e) => e.data.kind === k))
    .map((e) => ({ url: `/playbook/${e.slug}/`, name: e.data.title })),
})];
---
<Base
  title="手法・定石・格言 ― 前提と限界つきのリファレンス"
  description="取引手法・相場の定石・格言のリファレンス。すべての手法記事に「前提条件」「検証の考え方」「限界と注意」を明記し、都合のよい部分だけを切り取らずに解説します。"
  pagebg={true}
  jsonLd={jsonLd}
>
  <header class="page-head" style="--eyebrow-dot:var(--color-sec-playbook)">
    <div class="container-wide">
      <p class="eyebrow">Playbook</p>
      <h1>手法・定石・格言</h1>
      <p class="lead">すべての手法・定石記事には「前提条件」「検証の考え方」「限界と注意」を必ず記載しています（<a href="/policy/">編集方針</a>）。</p>
      <ol class="rule3" aria-label="手法記事の必須3見出し">
        <li><span>01</span>前提条件</li>
        <li><span>02</span>検証の考え方</li>
        <li><span>03</span>限界と注意</li>
      </ol>
      <p class="count">公開 {all.length}本 ・ {groups.length}分類</p>
    </div>
  </header>

  <div class="container-wide body">
    <nav class="jump" aria-label="分類へ移動">
      <ul>
        {groups.map((g) => (
          <li><a href={`#${g.id}`}>{g.kind}<span>{g.items.length}</span></a></li>
        ))}
      </ul>
    </nav>

    {groups.map((g) => (
      <section class="group" id={g.id}>
        <div class="sec-head">
          <h2>{g.kind}</h2>
          <span class="sec-sub">{g.items.length}本</span>
        </div>
        <ul class="post-list cols">
          {g.items.map((e) => (
            <li>
              <a class="post-link" href={`/playbook/${e.slug}/`}>
                <span class="pt">{e.data.title}</span>
                <span class="pm">
                  {bestGrade(e.data.sources) && <span class="bg bg-src">出典{bestGrade(e.data.sources)}</span>}
                  <time datetime={ymd(e.data.updated)}>{fmt(e.data.updated)} 更新</time>
                </span>
                <span class="arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
  <style>
    .rule3 {
      list-style: none; margin: 1.1rem 0 0; padding: 0;
      display: flex; flex-wrap: wrap; gap: .4rem .5rem;
    }
    .rule3 li {
      display: inline-flex; align-items: center; gap: .5em;
      background: var(--color-bg); border: 1px solid var(--color-grid-strong); border-radius: var(--radius-s);
      padding: .25rem .7rem; font-size: .82rem; font-weight: 700; color: var(--color-ink);
    }
    .rule3 span { font-family: var(--font-num); font-size: .7rem; color: var(--color-sec-playbook); }

    .body { padding-top: 1.4rem; padding-bottom: 4rem; }
    .jump ul { list-style: none; margin: 0 0 .6rem; padding: 0; display: flex; flex-wrap: wrap; gap: .4rem; }
    .jump a {
      display: inline-flex; align-items: center; gap: .5em; min-height: 44px; padding: 0 .95rem;
      border: 1px solid var(--color-border); border-radius: 999px; background: var(--color-bg);
      font-size: .88rem; font-weight: 700; color: var(--color-ink); text-decoration: none;
    }
    .jump a:hover { border-color: var(--color-sec-playbook); color: var(--color-sec-playbook); }
    .jump span { font-family: var(--font-num); font-size: .72rem; color: var(--color-text-muted); font-weight: 500; }

    .group { margin-top: 2.4rem; scroll-margin-top: 1rem; }
    .group .sec-head h2::before {
      content: ""; display: inline-block; width: .5rem; height: .5rem; border-radius: 2px;
      background: var(--color-sec-playbook); margin-right: .55rem; vertical-align: .2em;
    }
    /* 2段組の行リスト（白い帳面＋行罫） */
    .cols {
      display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 2rem;
      background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius);
      box-shadow: var(--shadow-card); padding: 0 1.2rem;
    }
    .cols > li { border-bottom: 1px solid var(--color-border); }
    .cols > li:last-child { border-bottom: 1px solid var(--color-border); }
    /* 最終行（奇数本なら1つ・偶数本なら2つ）の罫を消す */
    .cols > li:nth-last-child(1), .cols > li:nth-last-child(2):nth-child(odd) { border-bottom: none; }
    .cols .post-link { padding: .8rem .1rem; min-height: 44px; height: 100%; align-content: center; }
    .cols .post-link .pt { font-size: .96rem; }
    @media (max-width: 760px) {
      .cols { grid-template-columns: minmax(0, 1fr); padding: 0 .85rem; }
      .cols > li:nth-last-child(2):nth-child(odd) { border-bottom: 1px solid var(--color-border); }
    }
  </style>
</Base>
