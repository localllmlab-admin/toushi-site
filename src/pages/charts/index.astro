---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import { collectionPageJsonLd } from "../../lib/seo.mjs";
const TYPES =["反転", "継続", "プライスアクション", "インジケーター"];
const all = (await getCollection("charts")).filter((e) => e.data.reviewed);

// 一覧ページの構造化データ（CollectionPage + ItemList）
const jsonLd = [collectionPageJsonLd({
  path: "/charts/",
  name: "チャート図解｜投資の学び舎",
  description: "チャートパターン・プライスアクション・インジケーターの図解リファレンス。",
  items: TYPES.flatMap((t) => all.filter((e) => e.data.patternType === t))
    .map((e) => ({ url: `/charts/${e.slug}/`, name: e.data.title })),
})];
---
<Base
  title="チャート図解 ― パターンと指標の見方"
  description="チャートパターン・ローソク足のプライスアクション・インジケーターを図解で解説。反転と継続の見分け方、だましの避け方まで出典付きでまとめたリファレンスです。"
  jsonLd={jsonLd}
>
  <div class="container">
    <p class="section-label" style="color:var(--color-sec-charts)">CHARTS</p>
    <h1>チャート図解</h1>
    {TYPES.map((t) => {
      const items = all.filter((e) => e.data.patternType === t);
      return items.length > 0 && (
        <section><h2>{t}</h2>
          <ul>{items.map((e) => <li><a href={`/charts/${e.slug}/`}>{e.data.title}</a></li>)}</ul>
        </section>
      );
    })}
  </div>
  <style>
    .container { padding: 2.4rem 1.25rem 3.5rem; }
    .section-label { font-family: var(--font-mono); font-size: .75rem; letter-spacing: .06em; margin: 0 0 .3rem; }
    ul { list-style: none; padding: 0; }
    li { padding: .5rem 0; border-bottom: 1px solid var(--color-border); }
    section { margin-top: 1.8rem; }
  </style>
</Base>
