---
import Base from "./Base.astro";
import Disclaimer from "../components/Disclaimer.astro";
import Toc from "../components/Toc.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import { breadcrumbJsonLd } from "../lib/seo.mjs";
import { neighborsOf } from "../lib/sequence.mjs";
import { getCollection } from "astro:content";
import { topicsOf } from "../data/topics.mjs";
import { existsSync } from "node:fs";
const { entry, headings = [] } = Astro.props;
const { title, description, updated, reviewedAt, sources = [] } = entry.data;

// OGP画像（ops/og/generate_og.mjs で事前生成・コミット済のもののみ参照。未生成はdefaultへ）
const ogName = `${entry.collection}-${entry.slug}`;
const ogImage = existsSync(`public/og/${ogName}.jpg`) ? `/og/${ogName}.jpg` : "/og/default.jpg";

// 同じテーマの記事（テーマ別カテゴリの実データ分類から。根拠のない「おすすめ」は作らない）
const myTopics = topicsOf(entry.collection, entry.data);
let relatedTopic = null;
let related = [];
if (myTopics.length > 0) {
  relatedTopic = myTopics[0];
  const pub = (arr, collection) =>
    arr.filter((e) => e.data.reviewed).map((e) => ({ collection, e }));
  const all = [
    ...pub(await getCollection("learn"), "learn"),
    ...pub(await getCollection("playbook"), "playbook"),
    ...pub(await getCollection("charts"), "charts"),
  ];
  related = all
    .filter(({ collection, e }) =>
      relatedTopic.match(collection, e.data) &&
      !(collection === entry.collection && e.slug === entry.slug))
    .sort((a, b) => new Date(b.e.data.updated) - new Date(a.e.data.updated))
    .slice(0, 4);
}
// 前後の記事（一覧ページと同じ並び＝src/lib/sequence.mjs が単一定義）。
// 記事末尾に必ず2本の文脈リンクが入るので、本文にリンクがない記事でもクロール経路と
// 回遊導線が確保される。順序は実データ（章・レベル・順序）由来で、恣意的な推薦はしない。
const { prev, next, groupLabel } = neighborsOf(
  entry.collection,
  await getCollection(entry.collection),
  entry.slug,
);

const upd = new Date(updated).toLocaleDateString("ja-JP");
const rev = reviewedAt ? new Date(reviewedAt).toLocaleDateString("ja-JP") : null;
const gradeLabel = { A: "公的機関", B: "学術", C: "一次発表", D: "報道", E: "編集部調べ" };

// JSON-LD（構造化データ：信頼シグナル・発見性 / WO-TOUSHI-002(a)で拡張）
const siteName = "投資の学び舎（まなびや）";
const siteUrl = Astro.site?.href ?? "https://toushi-manabiya.jp/";
const pageUrl = new URL(`/${entry.collection}/${entry.slug}/`, siteUrl).href;
const org = {
  "@type": "Organization",
  name: siteName,
  url: siteUrl,
  logo: { "@type": "ImageObject", url: new URL("/og/default.jpg", siteUrl).href, width: 1200, height: 630 },
};
const sectionLabel = {
  learn: "学ぶ", playbook: "手法・定石", charts: "チャート図解", glossary: "用語集",
  books: "おすすめ書籍",
}[entry.collection];

// パンくずは画面表示（Breadcrumb.astro）と構造化データで同じ配列を使う。
// url はサイト相対で持つ（絶対URLにすると dev/preview でも本番へ飛ぶ）。
// 構造化データ側の絶対化は breadcrumbJsonLd 内の abs() が行う。
const trail = [
  { name: "ホーム", url: "/" },
  { name: sectionLabel, url: `/${entry.collection}/` },
  { name: title, url: `/${entry.collection}/${entry.slug}/` },
];

// 出典（広告リンクを除く）を citation として明示。E-E-A-T（何を根拠に書いたか）の機械可読化。
const citations = sources
  .filter((s) => s.url && !s.ad)
  .map((s) => ({ "@type": "CreativeWork", name: s.title, url: s.url }));

const jsonLdBlocks = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "@id": `${pageUrl}#article`,
    headline: title,
    description,
    // datePublished は公開ゲート（人間レビュー完了日）を採用。未設定時は updated へフォールバック
    datePublished: new Date(reviewedAt ?? updated).toISOString(),
    dateModified: new Date(updated).toISOString(),
    image: new URL(ogImage, siteUrl).href,
    mainEntityOfPage: { "@type": "WebPage", "@id": pageUrl },
    inLanguage: "ja",
    isAccessibleForFree: true,
    articleSection: sectionLabel,
    ...(entry.data.tags?.length ? { keywords: entry.data.tags.join(", ") } : {}),
    ...(citations.length ? { citation: citations } : {}),
    // 匿名運用（CLAUDE.md 絶対制約6）のため著者は編集部（組織）名義で統一する
    author: { "@type": "Organization", name: `${siteName}編集部`, url: siteUrl },
    publisher: org,
    ...(entry.data.chapter ? { about: { "@type": "Thing", name: entry.data.chapter } } : {}),
  },
  breadcrumbJsonLd({ trail, siteUrl }),
];

// 学習記事は LearningResource を併記し、章とレベルを機械可読にする。
// schema.org は多重型を許すので Article の rich result 対象からは外れない。
if (entry.collection === "learn") {
  const LEVELS = { 1: "入門", 2: "基礎", 3: "実践", 4: "上級" };
  const a = jsonLdBlocks[0];
  a["@type"] = ["Article", "LearningResource"];
  a.learningResourceType = "解説記事";
  if (entry.data.level) a.educationalLevel = LEVELS[entry.data.level];
  if (entry.data.chapter) a.teaches = entry.data.chapter;
}

// 書籍の Book 構造化データは BookCard.astro が出す（書誌データの持ち主が1か所であるべきなので、
// ここでは重複させない）。

// 用語集は DefinedTerm を追加（AI検索・リッチリザルト向けの機械可読化）
if (entry.collection === "glossary") {
  jsonLdBlocks.push({
    "@context": "https://schema.org",
    "@type": "DefinedTerm",
    name: entry.data.term,
    ...(entry.data.reading ? { alternateName: entry.data.reading } : {}),
    description,
    url: pageUrl,
    inDefinedTermSet: {
      "@type": "DefinedTermSet",
      name: `${siteName} 用語集`,
      url: new URL("/glossary/", siteUrl).href,
    },
  });
}
---
<Base title={title} description={description} ogImage={ogImage} jsonLd={jsonLdBlocks}>
  <article class="container">
    <Breadcrumb trail={trail} />
    <!-- PR表記は isPR: true で機械挿入（ステマ規制対応・frontmatterの他項目では消せない / ADR-0003） -->
    {entry.data.isPR && (
      <p class="pr-note">本ページにはアフィリエイト広告（PR）が含まれます</p>
    )}
    <h1>{title}</h1>
    <p class="meta">
      最終更新: <time datetime={new Date(updated).toISOString()}>{upd}</time>
      {rev && <>　/　レビュー日: <time datetime={new Date(reviewedAt).toISOString()}>{rev}</time> 済</>}
    </p>
    <Toc headings={headings} />
    <div class="body"><slot /></div>

    {sources.length > 0 && (
      <section class="sources">
        <h2>出典・参考</h2>
        <ul>{sources.map((s) => (
          <li>
            <span class={`grade grade-${s.grade}`}>{s.grade}: {gradeLabel[s.grade]}</span>
            {s.url
              ? <a
                  href={s.url}
                  target="_blank"
                  rel={s.ad ? "noopener noreferrer sponsored nofollow" : "noopener noreferrer nofollow"}
                >{s.title}</a>
              : <span>{s.title}</span>}
            {/* アフィリリンクはリンク近傍で広告性を明示（景表法ステマ規制対応 / ADR-0003） */}
            {s.ad && <span class="ad-badge">広告</span>}
          </li>
        ))}</ul>
        <p class="grade-note"><a href="/policy/">出典等級について（編集方針）</a></p>
      </section>
    )}

    {related.length > 0 && (
      <section class="related">
        <h2>同じテーマの記事</h2>
        <ul>
          {related.map(({ collection, e }) => (
            <li><a href={`/${collection}/${e.slug}/`}>{e.data.title}</a></li>
          ))}
        </ul>
        <p class="related-more"><a href={`/topics/${relatedTopic.slug}/`}>「{relatedTopic.title}」の記事一覧を見る ›</a></p>
      </section>
    )}

    {(prev || next) && (
      <nav class="seq" aria-label="前後の記事">
        <p class="seq-head">
          {groupLabel ? `「${groupLabel}」の順に読む` : "この一覧の順に読む"}
          <a href={`/${entry.collection}/`}>一覧へ ›</a>
        </p>
        <div class="seq-links">
          {prev ? (
            <a class="seq-prev" href={`/${entry.collection}/${prev.slug}/`} rel="prev">
              <span class="seq-label">‹ 前の記事</span>
              <span class="seq-title">{prev.data.title}</span>
            </a>
          ) : <span class="seq-empty" />}
          {next ? (
            <a class="seq-next" href={`/${entry.collection}/${next.slug}/`} rel="next">
              <span class="seq-label">次の記事 ›</span>
              <span class="seq-title">{next.data.title}</span>
            </a>
          ) : <span class="seq-empty" />}
        </div>
      </nav>
    )}

    <!-- 免責は常に機械描画。frontmatter では消せない。 -->
    <Disclaimer />
  </article>
  <style>
    .container { padding: 2.4rem 1.25rem 3.5rem; }
    .meta {
      color: var(--color-text-muted);
      font-size: 0.85rem;
      font-family: var(--font-mono);
    }
    /* PR表記（isPR時に機械挿入・ファーストビュー近傍） */
    .pr-note {
      display: inline-block;
      font-size: .78rem;
      font-weight: 700;
      color: var(--color-text-muted);
      background: var(--color-surface-muted);
      border: 1px solid var(--color-border-strong);
      border-radius: var(--radius-s);
      padding: .3em .8em;
      margin: 0 0 .6rem;
    }
    .body :global(h2) { margin-top: 2.4rem; border-bottom: 1px solid var(--color-border); padding-bottom: .3rem; }
    /* 用語集への自動リンク（rehype-glossary-links）は点線下線で本文リンクと区別 */
    .body :global(a.term-link) { text-decoration: underline dotted; text-underline-offset: 3px; }
    .body :global(figure.diagram) {
      margin: 1.6rem 0;
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
      background: #fff;
      padding: .8rem .8rem .7rem;
    }
    .body :global(figure.diagram img) { width: 100%; height: auto; display: block; }
    .body :global(figure.diagram figcaption) {
      font-size: .78rem;
      color: var(--color-text-muted);
      line-height: 1.6;
      margin-top: .5rem;
    }
    .related { margin-top: 2.5rem; font-size: .92rem; }
    .related h2 { border-bottom: 1px solid var(--color-border); padding-bottom: .3rem; }
    .related ul { list-style: none; padding: 0; margin: .6rem 0 0; }
    .related li { padding: .45rem 0; border-bottom: 1px dashed var(--color-border); }
    .related li a { font-weight: 700; text-decoration: none; }
    .related li a:hover { text-decoration: underline; }
    .related-more { font-size: .82rem; margin-top: .6rem; text-align: right; }
    .related-more a { font-weight: 700; text-decoration: none; }
    .related-more a:hover { text-decoration: underline; }
    /* 前後ナビ（連続した読み順の提示・機械描画） */
    .seq { margin-top: 2.5rem; }
    .seq-head {
      display: flex; justify-content: space-between; align-items: baseline; gap: 1rem;
      font-size: .82rem; color: var(--color-text-muted); margin: 0 0 .6rem;
      border-bottom: 1px solid var(--color-border); padding-bottom: .3rem;
    }
    .seq-head a { font-weight: 700; text-decoration: none; white-space: nowrap; }
    .seq-head a:hover { text-decoration: underline; }
    .seq-links { display: grid; grid-template-columns: 1fr 1fr; gap: .8rem; }
    .seq-links > a {
      display: flex; flex-direction: column; gap: .3rem;
      border: 1px solid var(--color-border); border-radius: var(--radius);
      padding: .8rem 1rem; text-decoration: none; background: var(--color-bg);
    }
    .seq-links > a:hover { border-color: var(--color-accent); }
    .seq-next { text-align: right; }
    .seq-label { font-size: .75rem; color: var(--color-text-muted); font-family: var(--font-mono); }
    .seq-title { font-size: .9rem; font-weight: 700; line-height: 1.5; }
    .seq-links > a:hover .seq-title { text-decoration: underline; }
    @media (max-width: 560px) {
      .seq-links { grid-template-columns: 1fr; }
      .seq-next { text-align: left; }
      .seq-empty { display: none; }
    }

    .sources { margin-top: 2.5rem; font-size: .9rem; }
    .sources h2 { border-bottom: 1px solid var(--color-border); padding-bottom: .3rem; }
    .sources li { margin: .5rem 0; }
    .sources a { word-break: break-all; }
    .grade {
      display: inline-block;
      font-family: var(--font-mono);
      font-size: .72rem;
      font-weight: 700;
      letter-spacing: 0.02em;
      padding: .15em .55em;
      border-radius: var(--radius-s);
      margin-right: .6em;
      border: 1px solid var(--color-border-strong);
      color: var(--color-text);
    }
    /* A: 公的機関 = 墨紺地・白文字（最上位の信頼シグナル） */
    .grade-A { background: var(--color-ink); border-color: var(--color-ink); color: var(--color-on-ink); }
    /* B/C: 学術・一次発表 = 罫線のみ（アクセント色） */
    .grade-B, .grade-C { background: var(--color-bg); color: var(--color-accent); border-color: var(--color-accent); }
    /* D: 報道 = グレー（事実単独での根拠にしないため一段控えめ） */
    .grade-D { background: var(--color-surface-muted); color: var(--color-text-muted); }
    /* E: 編集部調べ = リンクなしの編集責任表示（罫線のみ・控えめ） */
    .grade-E { background: var(--color-bg); color: var(--color-text-muted); }
    /* 広告バッジ = アフィリリンク近傍の広告明示（等級バッジと同系の機械描画） */
    .ad-badge {
      display: inline-block;
      font-family: var(--font-mono);
      font-size: .72rem;
      font-weight: 700;
      padding: .15em .55em;
      border-radius: var(--radius-s);
      margin-left: .5em;
      border: 1px solid var(--color-border-strong);
      background: var(--color-surface-muted);
      color: var(--color-text-muted);
    }
    .grade-note { font-size: .8rem; color: var(--color-text-muted); }
  </style>
</Base>
