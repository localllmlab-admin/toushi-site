---
import "../styles/tokens.css";
import { TOPICS } from "../data/topics.mjs";
const {
  title,
  description,
  pagebg = false,
  ogImage = "/og/default.jpg",
  // トップページ等、サイト名を後置せず1本のタイトルを使う場合に指定
  fullTitle = null,
  // ページ固有の構造化データ（配列）。サイト共通の WebSite/Organization は下で自動付与。
  jsonLd = [],
  noindex = false,
} = Astro.props;
const ogImageURL = new URL(ogImage, Astro.site);
// SERPでの表示幅を稼ぐため、後置するサイト名は短縮形にする（読み仮名付きの正式名はog:site_name側で担保）
const SITE_SHORT = "投資の学び舎";
const FONT_CSS = "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=Shippori+Mincho+B1:wght@800&display=optional";
const SITE_NAME = "投資の学び舎（まなびや）";
const docTitle = fullTitle ?? `${title}｜${SITE_SHORT}`;
// ロゴがホームを兼ねるため「ホーム」は置かない。全項目を常時表示する（隠すと利用率が落ちる＝NN/G）
const nav = [
  { href: "/learn/", label: "学ぶ" },
  { href: "/playbook/", label: "手法・定石" },
  { href: "/charts/", label: "チャート図解" },
  { href: "/glossary/", label: "用語集" },
  { href: "/topics/", label: "テーマ別" },
  { href: "/books/", label: "書籍" },
  { href: "/policy/", label: "編集方針" },
  // スマホのみ表示（4列×2段の格子を埋める。PCはヘッダーの検索窓がある）
  { href: "/search/", label: "検索", spOnly: true },
];
const footCols = [
  { title: "学ぶ", links: [
    { href: "/learn/", label: "学習マップ（7章×4レベル）" },
    { href: "/playbook/", label: "手法・定石" },
    { href: "/charts/", label: "チャート図解" },
    { href: "/glossary/", label: "用語集" },
    { href: "/books/", label: "おすすめ書籍" },
  ] },
  { title: "テーマ別", links: TOPICS.map((t) => ({ href: `/topics/${t.slug}/`, label: t.title })) },
  { title: "このサイトについて", links: [
    { href: "/policy/", label: "編集方針・出典等級" },
    { href: "/topics/", label: "テーマ一覧" },
    { href: "/search/", label: "記事検索" },
    { href: "/rss.xml", label: "RSS" },
  ] },
];
const path = Astro.url.pathname;
const isActive = (href) => (href === "/" ? path === "/" : path.startsWith(href));
const canonicalURL = new URL(path, Astro.site);
const siteUrl = Astro.site?.href ?? "https://toushi-manabiya.jp/";

// サイト共通の構造化データ。WebSite（サイトリンク検索ボックス）と Organization（発行者の同一性）は
// トップページ1箇所に置けば十分で、全ページに重複させない。
const siteJsonLd = path === "/" ? [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${siteUrl}#website`,
    name: SITE_NAME,
    alternateName: ["投資の学び舎", "toushi-manabiya"],
    url: siteUrl,
    inLanguage: "ja",
    description,
    publisher: { "@id": `${siteUrl}#organization` },
    potentialAction: {
      "@type": "SearchAction",
      target: { "@type": "EntryPoint", urlTemplate: `${siteUrl}search/?q={search_term_string}` },
      "query-input": "required name=search_term_string",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": `${siteUrl}#organization`,
    name: SITE_NAME,
    url: siteUrl,
    logo: { "@type": "ImageObject", url: new URL("/og/default.jpg", siteUrl).href, width: 1200, height: 630 },
    // 匿名運用（CLAUDE.md 絶対制約6）のため個人名は出さず、編集方針ページを同一性の根拠にする
    publishingPrinciples: new URL("/policy/", siteUrl).href,
  },
] : [];
const allJsonLd = [...siteJsonLd, ...jsonLd];
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{docTitle}</title>
    <meta name="description" content={description} />
    {/*
      robots ディレクティブは常に明示する。
      max-image-preview:large = SERP／Discoverで大サイズ画像プレビューを許可（既定はstandard＝小）。
      max-snippet:-1 / max-video-preview:-1 = スニペット長の自主制限を外す。
      いずれも「許可を広げる」指定で、指定しないと保守的な既定値が使われる。
    */}
    <meta
      name="robots"
      content={noindex
        ? "noindex,follow"
        : "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"}
    />
    <link rel="canonical" href={canonicalURL} />
    {/* Bing Webmaster Tools の所有確認（流入1位がBing・Copilot系のため登録）。確認後も消すと所有権が外れる */}
    <meta name="msvalidate.01" content="32460326966C1A328A71E0E1349F4C43" />
    <meta property="og:title" content={title ?? docTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={path === "/" ? "website" : "article"} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content="投資の学び舎（まなびや）" />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* 見出し明朝とデータ用等幅。display=optional = 間に合わなければOSフォントのまま描画しCLSを出さない */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <noscript><link rel="stylesheet" href={FONT_CSS} /></noscript>
    <meta name="theme-color" content="#142340" />
    <link rel="alternate" type="application/rss+xml" title="投資の学び舎（まなびや）" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {allJsonLd.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
    <!-- Google Analytics 4（計測のみ・個人情報は送信しない） -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-NHFCSX4GTF"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag("js", new Date());
      gtag("config", "G-NHFCSX4GTF");
    </script>
  </head>
  <body class={pagebg ? "has-pagebg" : ""}>
    <a class="skip" href="#main" data-pagefind-ignore="all">本文へ移動</a>
    <header class="site-head" data-pagefind-ignore="all">
      <div class="head-row container-wide">
        <a class="brand" href="/">
          {/* ブランドマーク: 方眼の上の陰線（藍）と陽線（朱）＝罫線帳と赤ペン。public/favicon.svg と同一 */}
          <svg class="brand-mark" viewBox="0 0 32 32" width="34" height="34" aria-hidden="true">
            <rect width="32" height="32" rx="6" fill="#142340" />
            <path d="M8 0v32M16 0v32M24 0v32M0 8h32M0 16h32M0 24h32" stroke="#ffffff" stroke-opacity=".09" />
            <path d="M11.5 7v18" stroke="#6f9ad6" stroke-width="1.6" stroke-linecap="round" />
            <rect x="8.5" y="11" width="6" height="9" rx="1" fill="#6f9ad6" />
            <path d="M21 6v19" stroke="#e2574a" stroke-width="1.6" stroke-linecap="round" />
            <rect x="18" y="9" width="6" height="11" rx="1" fill="#e2574a" />
          </svg>
          <span class="brand-text">
            <span class="brand-word">投資の学び舎</span>
            <span class="brand-read">MANABIYA</span>
          </span>
        </a>
        <p class="brand-tag">相場を、正しく学ぶ。</p>
        <form class="head-search" action="/search/" method="get" role="search">
          <label class="sr" for="head-q">サイト内検索</label>
          <input id="head-q" name="q" type="search" placeholder="用語・テーマで検索" autocomplete="off" />
          <button type="submit" aria-label="検索する">
            <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M13 13l4.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          </button>
        </form>
      </div>
      <nav class="gnav" aria-label="サイト内ナビゲーション">
        <ul class="container-wide">
          {nav.map((n) => (
            <li class={n.spOnly ? "sp-only" : undefined}><a href={n.href} aria-current={isActive(n.href) ? "page" : undefined}>{n.label}</a></li>
          ))}
        </ul>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-foot">
      <div class="container-wide foot-grid">
        <div class="foot-brand">
          <p class="foot-name">投資の学び舎<small>MANABIYA</small></p>
          <p class="foot-mission">煽らず、断定せず、一次情報に基づいて。投資とトレードを、出典付き・レベル別に学べる教科書サイトです。</p>
        </div>
        {footCols.map((c, i) => (
          <nav class={`foot-col foot-col-${i + 1}`} aria-label={c.title}>
            <p class="foot-h">{c.title}</p>
            <ul>{c.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
          </nav>
        ))}
      </div>
      <div class="container-wide foot-bottom">
        <p class="foot-disclaimer">
          【免責事項】本サイトは投資教育・情報提供を目的としており、特定の金融商品の売買を推奨または勧誘するものではありません。掲載情報の正確性には万全を期していますが、その完全性・最新性を保証するものではありません。投資に関する最終決定はご自身の判断でお願いいたします。本サイトの情報に基づく損失について、運営者は一切の責任を負いません。記事内の出典は等級（A=公的機関・規制当局・取引所、B=学術、C=企業一次発表、D=報道）を明示しています。
        </p>
        <p class="foot-copy">© 2026 投資の学び舎（toushi-manabiya.jp）</p>
      </div>
    </footer>
    {/* 見出し用Webフォントは本文の後でJSから差し込む。head に <link> を置くと（media=print でも）
        描画ブロック扱いになり、構造化データで head が大きいページほど初回描画が遅れた（Lighthouse実測）。
        display=optional なので、間に合わない回はOSフォントのまま＝レイアウトシフトなし */}
    <script is:inline define:vars={{ FONT_CSS }}>
      var l = document.createElement("link"); l.rel = "stylesheet"; l.href = FONT_CSS; document.head.appendChild(l);
    </script>
    <style is:global>
      body.has-pagebg { background: var(--color-page); }
      .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    </style>
    <style>
      .skip {
        position: absolute; left: 1rem; top: -60px; z-index: 10; background: var(--color-ink); color: #fff;
        padding: .6rem 1rem; border-radius: var(--radius); text-decoration: none; font-weight: 700;
      }
      .skip:focus { top: .5rem; }

      .site-head { background: var(--color-paper); border-bottom: 1px solid var(--color-border); }
      .head-row { display: flex; align-items: center; gap: 1rem; min-height: 68px; }
      .brand { display: inline-flex; align-items: center; gap: .65rem; text-decoration: none; color: var(--color-ink); min-height: 44px; }
      .brand-mark { flex-shrink: 0; display: block; }
      .brand-text { display: inline-flex; flex-direction: column; line-height: 1.15; }
      .brand-word { font-family: var(--font-display); font-weight: 800; font-size: 1.32rem; letter-spacing: .06em; }
      .brand-read { font-family: var(--font-mono); font-size: .58rem; letter-spacing: .34em; color: var(--color-text-muted); margin-top: 3px; }
      .brand-tag {
        margin: 0; font-size: .78rem; color: var(--color-text-muted); letter-spacing: .12em;
        border-left: 1px solid var(--color-border-strong); padding-left: 1rem;
      }
      .head-search {
        margin-left: auto; display: flex; align-items: center; width: min(320px, 32vw);
        background: var(--color-bg); border: 1px solid var(--color-border-strong); border-radius: 999px;
        padding-left: 1rem; transition: border-color .2s var(--ease), box-shadow .2s var(--ease);
      }
      .head-search:focus-within { border-color: var(--color-accent); box-shadow: 0 0 0 3px rgba(31, 79, 153, .15); }
      .head-search input {
        flex: 1; min-width: 0; border: 0; background: transparent; font: inherit; font-size: .86rem;
        color: var(--color-text); padding: .55rem 0; outline: none;
      }
      .head-search input::-webkit-search-cancel-button { display: none; }
      .head-search button {
        border: 0; background: transparent; color: var(--color-ink); width: 44px; height: 40px;
        display: inline-flex; align-items: center; justify-content: center; cursor: pointer; border-radius: 999px;
      }
      .head-search button:hover { color: var(--color-cta); }
      .gnav .sp-only { display: none; }

      .gnav ul { list-style: none; margin: 0 auto; display: flex; gap: .2rem; }
      .gnav a {
        position: relative; display: inline-flex; align-items: center; min-height: 46px; padding: 0 .9rem;
        color: var(--color-text); font-weight: 700; font-size: .9rem; text-decoration: none; letter-spacing: .05em;
      }
      .gnav li:first-child a { padding-left: 0; }
      .gnav a::after {
        content: ""; position: absolute; left: .9rem; right: .9rem; bottom: -1px; height: 2px;
        background: var(--color-cta); transform: scaleX(0); transform-origin: left; transition: transform .25s var(--ease);
      }
      .gnav li:first-child a::after { left: 0; }
      .gnav a:hover { color: var(--color-ink); }
      .gnav a:hover::after { transform: scaleX(.5); }
      .gnav a[aria-current="page"] { color: var(--color-ink); }
      .gnav a[aria-current="page"]::after { transform: scaleX(1); }

      @media (max-width: 900px) {
        .brand-tag { display: none; }
      }
      @media (max-width: 720px) {
        .head-row { min-height: 60px; }
        .head-search { display: none; }
        .gnav .sp-only { display: block; }
        /* スマホでもナビは全項目を常時表示（4列×2段の格子＝方眼の手ざわり）。隠すと利用率が落ちる */
        .gnav ul {
          display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0; padding: 0;
          border-top: 1px solid var(--color-border);
        }
        .gnav li { border-right: 1px solid var(--color-border); }
        .gnav li:nth-child(4n) { border-right: 0; }
        .gnav li:nth-child(-n+4) { border-bottom: 1px solid var(--color-border); }
        .gnav a, .gnav li:first-child a { justify-content: center; width: 100%; padding: 0 .2rem; font-size: .8rem; min-height: 44px; letter-spacing: .02em; }
        .gnav a::after, .gnav li:first-child a::after { left: 22%; right: 22%; bottom: 0; }
      }

      main { display: block; }

      .site-foot {
        margin-top: clamp(3rem, 8vw, 5.5rem); color: var(--color-on-ink-muted);
        background:
          linear-gradient(rgba(255,255,255,.04) 1px, transparent 1px) 0 0 / var(--grid) var(--grid),
          linear-gradient(90deg, rgba(255,255,255,.04) 1px, transparent 1px) 0 0 / var(--grid) var(--grid),
          var(--color-ink);
      }
      .foot-grid {
        display: grid; grid-template-columns: 1.3fr 1fr 1.6fr 1fr; gap: 2rem 2.5rem;
        padding-top: 3rem; padding-bottom: 2rem;
      }
      .foot-name { font-family: var(--font-display); font-weight: 800; font-size: 1.4rem; color: #fff; margin: 0 0 .7rem; letter-spacing: .06em; }
      .foot-name small { font-family: var(--font-mono); font-size: .58rem; letter-spacing: .3em; margin-left: .7rem; color: var(--color-on-ink-muted); font-weight: 400; }
      .foot-mission { font-size: .82rem; line-height: 1.9; margin: 0; }
      .foot-h { font-size: .74rem; font-weight: 700; letter-spacing: .1em; color: var(--color-on-ink-muted); margin: 0 0 .5rem; padding-bottom: .5rem; border-bottom: 1px solid rgba(255,255,255,.14); }
      .foot-col ul { list-style: none; margin: 0; padding: 0; }
      .foot-col-2 ul { columns: 2; column-gap: 1.2rem; }
      .foot-col li { break-inside: avoid; }
      .foot-col a {
        color: var(--color-on-ink); text-decoration: none; font-size: .84rem;
        display: inline-flex; align-items: center; min-height: 36px; line-height: 1.5;
      }
      .foot-col a:hover { color: #fff; text-decoration: underline; }
      .foot-bottom { padding-bottom: 2rem; }
      .foot-bottom > p:first-child { border-top: 1px solid rgba(255,255,255,.14); padding-top: 1.3rem; }
      .foot-disclaimer { margin: 0; font-size: .74rem; line-height: 1.9; }
      .foot-copy { margin: .9rem 0 0; font-size: .72rem; font-family: var(--font-num); }
      @media (max-width: 900px) {
        .foot-grid { grid-template-columns: 1fr 1fr; }
        .foot-brand, .foot-col-2 { grid-column: 1 / -1; }
      }
      @media (max-width: 480px) {
        .foot-col a { min-height: 44px; }
      }
    </style>
  </body>
</html>
